<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <!-- Custom configuration section for license release service -->
    <section name="licenseReleaseService" type="LicenseReleaseService.Configuration.LicenseReleaseServiceSection, LicenseReleaseService" />

    <!-- Configuration section for connection strings -->
    <section name="connectionStrings" type="System.Configuration.ConnectionStringsSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" requirePermission="false" />

    <!-- Configuration section for application settings -->
    <section name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <!-- General application settings -->
  <appSettings>
    <!-- Service Configuration -->
    <add key="ServiceName" value="LicenseReleaseService" />
    <add key="Environment" value="Production" />
    <add key="Version" value="1.0.0" />
    <add key="PollingInterval" value="300" />
    <add key="MaxConcurrentOperations" value="10" />

    <!-- Service Mode Configuration -->
    <add key="ServiceMode" value="Automatic" />
    <add key="StartupDelay" value="10" />
    <add key="ShutdownTimeout" value="30" />

    <!-- Debug and Development Settings -->
    <add key="DebugMode" value="false" />
    <add key="EnableDiagnostics" value="true" />
    <add key="LogConfigurationChanges" value="true" />

    <!-- File Paths and Directories -->
    <add key="ConfigBackupPath" value="C:\ProgramData\LicenseReleaseService\Backup" />
    <add key="TempFilePath" value="C:\ProgramData\LicenseReleaseService\Temp" />
    <add key="WorkingDirectory" value="C:\ProgramData\LicenseReleaseService" />

    <!-- Performance Settings -->
    <add key="ThreadPoolMinThreads" value="2" />
    <add key="ThreadPoolMaxThreads" value="10" />
    <add key="CacheTimeout" value="300" />

    <!-- Error Handling Settings -->
    <add key="EnableErrorRecovery" value="true" />
    <add key="MaxRetryAttempts" value="3" />
    <add key="RetryDelay" value="5000" />

    <!-- Event Logging Settings -->
    <add key="EventLogSource" value="LicenseReleaseService" />
    <add key="EventLogName" value="Application" />
    <add key="EnableEventLogging" value="true" />

    <!-- Timer Execution Settings -->
    <add key="EnableTimerExecution" value="true" />
    <add key="TimerStartupDelay" value="10" />
    <add key="TimerDefaultInterval" value="60" />
    <add key="TimerHealthCheckInterval" value="60" />
    <add key="TimerMetricsCollectionInterval" value="30" />
    <add key="TimerConfigurationCacheDuration" value="300" />
    <add key="EnableTimerConfigWatcher" value="true" />
    <add key="EnableTimerStatistics" value="true" />
    <add key="EnableTimerMetrics" value="true" />
    <add key="EnableTimerAdaptiveScheduling" value="false" />
    <add key="TimerMemoryThreshold" value="52428800" />
    <add key="TimerCpuThreshold" value="80" />
    <add key="TimerThreadPoolThreshold" value="10" />
    <add key="TimerMaxExecutionHistory" value="100" />
    <add key="PreventTimerExecutionOverlap" value="true" />
    <add key="EnableTimerCircuitBreaker" value="true" />
    <add key="TimerCircuitBreakerCooldown" value="300" />
    <add key="TimerMaxConsecutiveErrors" value="5" />
    <add key="EnableTimerAutoRestart" value="true" />
    <add key="EnableTimerExecutionTimeout" value="true" />
    <add key="TimerExecutionTimeout" value="300" />
    <add key="EnableTimerDetailedLogging" value="true" />
    <add key="TimerStopOnUnhandledException" value="false" />
    <add key="TimerDisposalGracePeriod" value="5" />
    <add key="TimerSyncTimeout" value="30" />
    <add key="TimerMinInterval" value="1" />
    <add key="TimerMaxInterval" value="86400" />

    <!-- Version-specific configuration settings -->
    <add key="EnableVersionSpecificTimerConfig" value="false" />
    <add key="TimerTargetVersion" value="" />
    <add key="TimerDefaultVersion" value="" />
    <add key="TimerSupportedVersions" value="2020,2021,2022,2023,2024,2025" />
    <add key="TimerVersionDetectionInterval" value="1800" />
    <add key="EnableTimerVersionFallback" value="true" />
    <add key="TimerVersionDetectionEnabled" value="true" />

    <!-- Version-specific timer settings for SolidWorks 2025 -->
    <add key="SW2025_TimerDefaultInterval" value="180" />
    <add key="SW2025_TimerExecutionTimeout" value="240" />
    <add key="SW2025_TimerCircuitBreakerCooldown" value="480" />
    <add key="SW2025_TimerMaxExecutionHistory" value="75" />
    <add key="SW2025_TimerMaxConsecutiveErrors" value="3" />

    <!-- Version-specific timer settings for SolidWorks 2024 -->
    <add key="SW2024_TimerDefaultInterval" value="240" />
    <add key="SW2024_TimerExecutionTimeout" value="300" />
    <add key="SW2024_TimerCircuitBreakerCooldown" value="600" />
    <add key="SW2024_TimerMaxExecutionHistory" value="60" />
    <add key="SW2024_TimerMaxConsecutiveErrors" value="4" />

    <!-- Version-specific timer settings for SolidWorks 2023 -->
    <add key="SW2023_TimerDefaultInterval" value="300" />
    <add key="SW2023_TimerExecutionTimeout" value="360" />
    <add key="SW2023_TimerCircuitBreakerCooldown" value="720" />
    <add key="SW2023_TimerMaxExecutionHistory" value="50" />
    <add key="SW2023_TimerMaxConsecutiveErrors" value="5" />

    <!-- Version-specific timer settings for SolidWorks 2022 -->
    <add key="SW2022_TimerDefaultInterval" value="360" />
    <add key="SW2022_TimerExecutionTimeout" value="420" />
    <add key="SW2022_TimerCircuitBreakerCooldown" value="840" />
    <add key="SW2022_TimerMaxExecutionHistory" value="40" />
    <add key="SW2022_TimerMaxConsecutiveErrors" value="6" />

    <!-- Version-specific timer settings for SolidWorks 2021 -->
    <add key="SW2021_TimerDefaultInterval" value="420" />
    <add key="SW2021_TimerExecutionTimeout" value="480" />
    <add key="SW2021_TimerCircuitBreakerCooldown" value="960" />
    <add key="SW2021_TimerMaxExecutionHistory" value="30" />
    <add key="SW2021_TimerMaxConsecutiveErrors" value="7" />

    <!-- Version-specific timer settings for SolidWorks 2020 -->
    <add key="SW2020_TimerDefaultInterval" value="480" />
    <add key="SW2020_TimerExecutionTimeout" value="540" />
    <add key="SW2020_TimerCircuitBreakerCooldown" value="1080" />
    <add key="SW2020_TimerMaxExecutionHistory" value="25" />
    <add key="SW2020_TimerMaxConsecutiveErrors" value="8" />
  </appSettings>

  <!-- License Release Service Configuration -->
  <licenseReleaseService>
    <!-- License Manager Settings -->
    <licenseManager
      lmutilPath="C:\Program Files\Autodesk\Network License Manager\lmutil.exe"
      licenseServer="license-server.company.com"
      port="27000"
      timeout="30"
      retryCount="3"
      commandTimeout="60"
      maxConcurrentLicenses="5"
      releaseDelay="1000"
      validatePath="true"
      enableHealthCheck="true"
      healthCheckInterval="300"
    />

    <!-- Logging Configuration -->
    <logging
      logLevel="Information"
      logFilePath="C:\Logs\LicenseReleaseService"
      maxFileSize="10485760"
      maxFiles="5"
      enableFileLogging="true"
      enableEventLog="true"
      enableConsoleLogging="false"
      logRetentionDays="30"
      includeTimestamp="true"
      includeThreadId="true"
      logTemplate="{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
      errorLogTemplate="{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] [{SourceContext}] {Message}{NewLine}{Exception}"
    />

    <!-- Monitoring Configuration -->
    <monitoring
      healthCheckInterval="60"
      performanceCountersEnabled="true"
      enableMetrics="true"
      metricsInterval="30"
      alertThreshold="90"
      enableHeartbeat="true"
      heartbeatInterval="120"
      enableStatistics="true"
      statisticsInterval="300"
      maxStatisticsHistory="1000"
      enableDiagnostics="true"
      memoryLimit="1073741824"
      cpuLimit="80"
    />

    <!-- Security Configuration -->
    <security
      enableAuthentication="false"
      enableAuthorization="false"
      encryptionKey=""
      enableSecureCommunication="false"
      certificatePath=""
      certificatePassword=""
      allowedHosts=""
      enableIpWhitelist="false"
      allowedIps=""
      enableAuditLogging="true"
      auditLogPath="C:\Logs\LicenseReleaseService\Audit"
      sessionTimeout="1800"
      maxFailedAttempts="5"
      lockoutDuration="900"
    />

    <!-- Process Execution Configuration -->
    <processExecution
      timeout="30"
      maxRetries="3"
      retryDelay="5"
      commandTimeout="60"
      createNoWindow="true"
      useShellExecute="false"
      redirectStandardInput="false"
      enableDetailedLogging="true"
      killProcessTreeOnTimeout="true"
      bufferSize="4096"
      maxOutputSize="0"
      throwOnNonZeroExitCode="false"
      workingDirectory=""
      enablePerformanceMonitoring="true"
      performanceMetricsInterval="30"
      enableHealthMonitoring="true"
      healthCheckInterval="60"
      enableErrorRecovery="true"
      errorRecoveryTimeout="120"
      enableAlerting="true"
      alertThreshold="90"
      encoding="UTF8"
    />

    <!-- License Query Configuration -->
    <licenseQuery
      cacheExpiration="00:05:00"
      queryTimeout="00:00:30"
      parsingTimeout="00:00:15"
      serverResponseTimeout="00:00:20"
      retryDelay="00:00:02"
      maxRetries="3"
      maxCacheSize="1000"
      maxMemoryUsage="52428800"
      maxConcurrentQueries="10"
      maxOutputSize="10485760"
      statisticsRetentionDays="30"
      maxStatisticsEntries="10000"
      enableCaching="true"
      enableStatistics="true"
      enableVerboseOutput="false"
      enableDetailedParsing="true"
      enableErrorRecovery="true"
      enableIncrementalUpdates="true"
      enableFeatureBatching="true"
      enableUserActivityTracking="true"
      enableBorrowingTracking="true"
      enableHealthMonitoring="true"
      enablePerformanceMetrics="true"
      enableAlerting="true"
      failFastOnInvalidData="false"
      enableAutoCleanup="true"
      enableCompactOutput="false"
      defaultOutputFormat="Standard"
      preferredLanguage="en-US"
      alertThreshold="90"
      cleanupInterval="3600"
      healthCheckInterval="60"
      performanceMetricsInterval="30"
    />

    <!-- Timer Execution Configuration -->
    <timer
      defaultInterval="00:01:00"
      maxConsecutiveErrors="5"
      maxConcurrentExecutions="1"
      circuitBreakerCooldown="00:05:00"
      enableAutoRestart="true"
      enableExecutionTimeout="true"
      executionTimeout="00:05:00"
      enableMetrics="true"
      enableDetailedLogging="true"
      enableCircuitBreaker="true"
      maxExecutionHistory="100"
      minInterval="00:00:01"
      maxInterval="1.00:00:00"
      syncTimeout="00:00:30"
      stopOnUnhandledException="false"
      disposalGracePeriod="00:00:05"
      preventExecutionOverlap="true"
      startupDelay="00:00:10"
      shutdownTimeout="00:00:30"
      healthCheckInterval="60"
      metricsCollectionInterval="30"
      enableAdaptiveScheduling="false"
      adaptiveThreshold="80"
      adaptiveCooldown="00:05:00"
      enableMemoryMonitoring="true"
      memoryThreshold="52428800"
      enableCpuMonitoring="true"
      cpuThreshold="80"
      enableThreadMonitoring="true"
      maxThreadPoolThreads="10"
      targetVersion=""
      defaultVersion=""
      enableVersionSpecificConfig="false"
      versionDetectionInterval="00:30:00"
      enableVersionFallback="true"
      supportedVersions="2020,2021,2022,2023,2024,2025"
    />
  </licenseReleaseService>

  <!-- System Diagnostics Configuration -->
  <system.diagnostics>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <!-- Console trace listener for debugging -->
        <add name="ConsoleListener" type="System.Diagnostics.ConsoleTraceListener"
             traceOutputOptions="DateTime, Timestamp, Callstack" />

        <!-- Text file trace listener -->
        <add name="TextFileListener" type="System.Diagnostics.TextWriterTraceListener"
             initializeData="C:\Logs\LicenseReleaseService\diagnostics.log"
             traceOutputOptions="DateTime, Timestamp, ProcessId, ThreadId" />

        <!-- Event log trace listener -->
        <add name="EventLogListener" type="System.Diagnostics.EventLogTraceListener"
             initializeData="LicenseReleaseService"
             traceOutputOptions="DateTime, Timestamp, Callstack" />
      </listeners>
    </trace>

    <sources>
      <source name="LicenseReleaseService" switchValue="Information">
        <listeners>
          <add name="TextFileListener" />
          <add name="EventLogListener" />
        </listeners>
      </source>

      <source name="LicenseManager" switchValue="Verbose">
        <listeners>
          <add name="TextFileListener" />
        </listeners>
      </source>

      <source name="ProcessExecution" switchValue="Information">
        <listeners>
          <add name="TextFileListener" />
        </listeners>
      </source>

      <source name="Configuration" switchValue="Warning">
        <listeners>
          <add name="TextFileListener" />
          <add name="EventLogListener" />
        </listeners>
      </source>
    </sources>

    <switches>
      <add name="DefaultTraceSwitch" value="Information" />
      <add name="LicenseReleaseServiceSwitch" value="Information" />
      <add name="LicenseManagerSwitch" value="Verbose" />
      <add name="ProcessExecutionSwitch" value="Information" />
      <add name="ConfigurationSwitch" value="Warning" />
    </switches>

    <sharedListeners>
      <add name="FileLog" type="System.Diagnostics.TextWriterTraceListener"
           initializeData="C:\Logs\LicenseReleaseService\shared.log" />
    </sharedListeners>
  </system.diagnostics>

  <!-- Application Settings Section -->
  <applicationSettings>
    <LicenseReleaseService.Properties.Settings>
      <setting name="DefaultTimeout" serializeAs="String">
        <value>00:01:00</value>
      </setting>
      <setting name="MaxRetryCount" serializeAs="String">
        <value>3</value>
      </setting>
      <setting name="EnablePerformanceCounters" serializeAs="String">
        <value>True</value>
      </setting>
    </LicenseReleaseService.Properties.Settings>
  </applicationSettings>

  <!-- Connection Strings Section -->
  <connectionStrings>
    <!-- Database connection strings if needed in future -->
    <add name="LicenseReleaseServiceDB"
         connectionString="Data Source=.;Initial Catalog=LicenseReleaseService;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />

    <!-- Monitoring database connection -->
    <add name="MonitoringDB"
         connectionString="Data Source=.;Initial Catalog=LicenseReleaseService_Monitoring;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <!-- Runtime Configuration -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Assembly binding redirects for compatibility -->
      <dependentAssembly>
        <assemblyIdentity name="System.Configuration" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <!-- Startup Configuration -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.1" />
  </startup>

  <!-- System.Net Configuration for Network Settings -->
  <system.net>
    <connectionManagement>
      <add address="*" maxconnection="100" />
    </connectionManagement>

    <defaultProxy>
      <proxy usesystemdefault="true" bypassonlocal="true" />
    </defaultProxy>

    <settings>
      <servicePointManager expect100Continue="false" useNagleAlgorithm="false" />
      <ipv6 enabled="true" />
    </settings>
  </system.net>

  <!-- Environment-specific Configuration Override -->
  <!-- Uncomment and modify for development environment -->
  <!--
  <appSettings file="App.config.development">
    <add key="Environment" value="Development" />
    <add key="DebugMode" value="true" />
    <add key="EnableDiagnostics" value="true" />
  </appSettings>
  -->

  <!-- Environment-specific Configuration Override -->
  <!-- Uncomment and modify for staging environment -->
  <!--
  <appSettings file="App.config.staging">
    <add key="Environment" value="Staging" />
    <add key="DebugMode" value="false" />
    <add key="EnableDiagnostics" value="true" />
  </appSettings>
  -->
</configuration>