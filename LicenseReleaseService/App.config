<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <!-- Custom configuration section for license release service -->
    <section name="licenseReleaseService" type="LicenseReleaseService.Configuration.LicenseReleaseServiceSection, LicenseReleaseService" />

    <!-- Configuration section for connection strings -->
    <section name="connectionStrings" type="System.Configuration.ConnectionStringsSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" requirePermission="false" />

    <!-- Configuration section for application settings -->
    <section name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <!-- General application settings -->
  <appSettings>
    <!-- Service Configuration -->
    <add key="ServiceName" value="LicenseReleaseService" />
    <add key="Environment" value="Production" />
    <add key="Version" value="1.0.0" />
    <add key="PollingInterval" value="300" />
    <add key="MaxConcurrentOperations" value="10" />

    <!-- Service Mode Configuration -->
    <add key="ServiceMode" value="Automatic" />
    <add key="StartupDelay" value="10" />
    <add key="ShutdownTimeout" value="30" />

    <!-- Debug and Development Settings -->
    <add key="DebugMode" value="false" />
    <add key="EnableDiagnostics" value="true" />
    <add key="LogConfigurationChanges" value="true" />

    <!-- File Paths and Directories -->
    <add key="ConfigBackupPath" value="C:\ProgramData\LicenseReleaseService\Backup" />
    <add key="TempFilePath" value="C:\ProgramData\LicenseReleaseService\Temp" />
    <add key="WorkingDirectory" value="C:\ProgramData\LicenseReleaseService" />

    <!-- Performance Settings -->
    <add key="ThreadPoolMinThreads" value="2" />
    <add key="ThreadPoolMaxThreads" value="10" />
    <add key="CacheTimeout" value="300" />

    <!-- Error Handling Settings -->
    <add key="EnableErrorRecovery" value="true" />
    <add key="MaxRetryAttempts" value="3" />
    <add key="RetryDelay" value="5000" />

    <!-- Event Logging Settings -->
    <add key="EventLogSource" value="LicenseReleaseService" />
    <add key="EventLogName" value="Application" />
    <add key="EnableEventLogging" value="true" />
  </appSettings>

  <!-- License Release Service Configuration -->
  <licenseReleaseService>
    <!-- License Manager Settings -->
    <licenseManager
      lmutilPath="C:\Program Files\Autodesk\Network License Manager\lmutil.exe"
      licenseServer="license-server.company.com"
      port="27000"
      timeout="30"
      retryCount="3"
      commandTimeout="60"
      maxConcurrentLicenses="5"
      releaseDelay="1000"
      validatePath="true"
      enableHealthCheck="true"
      healthCheckInterval="300"
    />

    <!-- Logging Configuration -->
    <logging
      logLevel="Information"
      logFilePath="C:\Logs\LicenseReleaseService"
      maxFileSize="10485760"
      maxFiles="5"
      enableFileLogging="true"
      enableEventLog="true"
      enableConsoleLogging="false"
      logRetentionDays="30"
      includeTimestamp="true"
      includeThreadId="true"
      logTemplate="{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
      errorLogTemplate="{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] [{SourceContext}] {Message}{NewLine}{Exception}"
    />

    <!-- Monitoring Configuration -->
    <monitoring
      healthCheckInterval="60"
      performanceCountersEnabled="true"
      enableMetrics="true"
      metricsInterval="30"
      alertThreshold="90"
      enableHeartbeat="true"
      heartbeatInterval="120"
      enableStatistics="true"
      statisticsInterval="300"
      maxStatisticsHistory="1000"
      enableDiagnostics="true"
      memoryLimit="1073741824"
      cpuLimit="80"
    />

    <!-- Security Configuration -->
    <security
      enableAuthentication="false"
      enableAuthorization="false"
      encryptionKey=""
      enableSecureCommunication="false"
      certificatePath=""
      certificatePassword=""
      allowedHosts=""
      enableIpWhitelist="false"
      allowedIps=""
      enableAuditLogging="true"
      auditLogPath="C:\Logs\LicenseReleaseService\Audit"
      sessionTimeout="1800"
      maxFailedAttempts="5"
      lockoutDuration="900"
    />
  </licenseReleaseService>

  <!-- System Diagnostics Configuration -->
  <system.diagnostics>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <!-- Console trace listener for debugging -->
        <add name="ConsoleListener" type="System.Diagnostics.ConsoleTraceListener"
             traceOutputOptions="DateTime, Timestamp, Callstack" />

        <!-- Text file trace listener -->
        <add name="TextFileListener" type="System.Diagnostics.TextWriterTraceListener"
             initializeData="C:\Logs\LicenseReleaseService\diagnostics.log"
             traceOutputOptions="DateTime, Timestamp, ProcessId, ThreadId" />

        <!-- Event log trace listener -->
        <add name="EventLogListener" type="System.Diagnostics.EventLogTraceListener"
             initializeData="LicenseReleaseService"
             traceOutputOptions="DateTime, Timestamp, Callstack" />
      </listeners>
    </trace>

    <sources>
      <source name="LicenseReleaseService" switchValue="Information">
        <listeners>
          <add name="TextFileListener" />
          <add name="EventLogListener" />
        </listeners>
      </source>

      <source name="LicenseManager" switchValue="Verbose">
        <listeners>
          <add name="TextFileListener" />
        </listeners>
      </source>

      <source name="ProcessExecution" switchValue="Information">
        <listeners>
          <add name="TextFileListener" />
        </listeners>
      </source>

      <source name="Configuration" switchValue="Warning">
        <listeners>
          <add name="TextFileListener" />
          <add name="EventLogListener" />
        </listeners>
      </source>
    </sources>

    <switches>
      <add name="DefaultTraceSwitch" value="Information" />
      <add name="LicenseReleaseServiceSwitch" value="Information" />
      <add name="LicenseManagerSwitch" value="Verbose" />
      <add name="ProcessExecutionSwitch" value="Information" />
      <add name="ConfigurationSwitch" value="Warning" />
    </switches>

    <sharedListeners>
      <add name="FileLog" type="System.Diagnostics.TextWriterTraceListener"
           initializeData="C:\Logs\LicenseReleaseService\shared.log" />
    </sharedListeners>
  </system.diagnostics>

  <!-- Application Settings Section -->
  <applicationSettings>
    <LicenseReleaseService.Properties.Settings>
      <setting name="DefaultTimeout" serializeAs="String">
        <value>00:01:00</value>
      </setting>
      <setting name="MaxRetryCount" serializeAs="String">
        <value>3</value>
      </setting>
      <setting name="EnablePerformanceCounters" serializeAs="String">
        <value>True</value>
      </setting>
    </LicenseReleaseService.Properties.Settings>
  </applicationSettings>

  <!-- Connection Strings Section -->
  <connectionStrings>
    <!-- Database connection strings if needed in future -->
    <add name="LicenseReleaseServiceDB"
         connectionString="Data Source=.;Initial Catalog=LicenseReleaseService;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />

    <!-- Monitoring database connection -->
    <add name="MonitoringDB"
         connectionString="Data Source=.;Initial Catalog=LicenseReleaseService_Monitoring;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <!-- Runtime Configuration -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Assembly binding redirects for compatibility -->
      <dependentAssembly>
        <assemblyIdentity name="System.Configuration" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <!-- Startup Configuration -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.1" />
  </startup>

  <!-- System.Net Configuration for Network Settings -->
  <system.net>
    <connectionManagement>
      <add address="*" maxconnection="100" />
    </connectionManagement>

    <defaultProxy>
      <proxy usesystemdefault="true" bypassonlocal="true" />
    </defaultProxy>

    <settings>
      <servicePointManager expect100Continue="false" useNagleAlgorithm="false" />
      <ipv6 enabled="true" />
    </settings>
  </system.net>

  <!-- Environment-specific Configuration Override -->
  <!-- Uncomment and modify for development environment -->
  <!--
  <appSettings file="App.config.development">
    <add key="Environment" value="Development" />
    <add key="DebugMode" value="true" />
    <add key="EnableDiagnostics" value="true" />
  </appSettings>
  -->

  <!-- Environment-specific Configuration Override -->
  <!-- Uncomment and modify for staging environment -->
  <!--
  <appSettings file="App.config.staging">
    <add key="Environment" value="Staging" />
    <add key="DebugMode" value="false" />
    <add key="EnableDiagnostics" value="true" />
  </appSettings>
  -->
</configuration>